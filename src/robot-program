        ISignalDI diPos1, 1, int_pos1_di;
        ISignalDI diPos2, 1, int_pos2_di;
        ISignalDI diPos3, 1, int_pos3_di;
        ISignalDI diPos4, 1, int_pos4_di;
        
        PulseDO \PLength:=1, doHome;
        
        WHILE TRUE DO
