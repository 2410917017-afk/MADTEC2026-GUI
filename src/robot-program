        CONNECT int_pos0_di WITH rutina_pos0;
        CONNECT int_pos1_di WITH rutina_pos1;
        CONNECT int_pos2_di WITH rutina_pos2;
        CONNECT int_pos3_di WITH rutina_pos3;
        CONNECT int_pos4_di WITH rutina_pos4;
        
        ISignalDI diStop, 1, int_paro_di; ! Designar entrada de paro a rutina de paro
