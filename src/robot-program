    TRAP rutina_paro
        
        StopMove; ! Detener todos los movimientos del robot de inmediato
        
        StorePath; ! Guardar la ruta actual 
        
        TPWrite "Robot detenido por HMI"; ! Indicar en pantalla que hubo un paro
        
        TPWrite "Por favor confirme para reanudar";
        WaitDI diRestart, 1; ! Esperar confirmación del PLC antes de continuar
        TPWrite "Reanudar movimiento";
        
        RestoPath; ! Restaurar y reanudar los movimientos
        StartMove;
        
    ENDTRAP
    
